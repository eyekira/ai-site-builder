# Core
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-long-random-secret"
AUTH_URL="http://localhost:5000"

# Auth (Google OAuth, optional but recommended)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Places (set at least one; GOOGLE_MAPS_API_KEY is preferred in code)
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_SERVER_KEY=""

# AI copy generation (optional; fallback copy used when missing)
OPENAI_API_KEY=""

# Host/domain handling (optional)
APP_HOST=""

# Upload mode
# Set PHOTO_UPLOAD_MODE=local for local filesystem uploads under public/uploads
PHOTO_UPLOAD_MODE="local"

# S3/R2 mode (used when all required S3 vars are present)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_BASE_URL=""

# Debug (optional)
DEBUG_VIEWER_CONTEXT="false"
